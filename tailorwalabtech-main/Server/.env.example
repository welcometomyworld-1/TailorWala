PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/tailorwala
JWT_SECRET=tailorwala-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=30d

# Client URL for CORS & Password Reset links
CLIENT_URL=http://localhost:5173

# Email configuration (Optional, fallback to Ethereal in development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
FROM_NAME=TailorWala
FROM_EMAIL=support@tailorwala.com

# Payment Gateway (Optional, fallback to secure Mock mode)
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
